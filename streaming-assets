  /* ---------------- caption parsing (SRT + VTT -> ms cues) ---------------- */
  function tsToMs(t) {
    var m = String(t).trim().replace(',', '.').match(/^(?:(\d+):)?(\d{1,2}):(\d{1,2})\.(\d{1,3})$/);
